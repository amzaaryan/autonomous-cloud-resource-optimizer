# Copy to .env and adjust values.
PROMETHEUS_URL=http://prometheus:9090

TARGET_SERVICE_NAME=target-service
TARGET_SERVICE_PORT=8000

# Workload intensity for target-service /work endpoint
WORK_INTENSITY_LOW_ITERATIONS=50000
WORK_INTENSITY_MEDIUM_ITERATIONS=250000
WORK_INTENSITY_HIGH_ITERATIONS=1000000

MIN_REPLICAS=1
MAX_REPLICAS=5
SCALE_STEP=1
COOLDOWN_SECONDS=60
CPU_SCALE_UP_THRESHOLD=0.70
CPU_SCALE_DOWN_THRESHOLD=0.35
MEMORY_SCALE_UP_THRESHOLD=0.75
LATENCY_SLA_MS=500
ERROR_RATE_SLA=0.05

TELEMETRY_INTERVAL_SECONDS=15
FORECAST_HORIZONS_MINUTES=1,3,5

# DRY_RUN=true only LOGS scaling decisions. Set false (or `make demo-live`) to really
# start/stop target-service containers through the Docker socket.
DRY_RUN=true
# compose: replicas are sibling containers cloned from the running one (plain `docker compose up`)
# swarm:   service.scale(n) on a Swarm service
SCALING_MODE=compose
TARGET_HEALTH_PATH=/health
REPLICA_READY_TIMEOUT_SECONDS=45
SCALE_DOWN_DRAIN_SECONDS=6

# --- capacity model (the predictive policy sizes the fleet from these) ---
# Per-replica CPU limit; CPU utilisation is aggregate cores / (replicas * this)
REPLICA_CPU_LIMIT_CORES=0.5
REPLICA_MEMORY_LIMIT=256M
# MEASURE THIS: `make calibrate` against one replica at your LOCUST_WORK_INTENSITY
RPS_PER_REPLICA_CAPACITY=90
TARGET_UTILIZATION=0.70
SCALE_DOWN_UTILIZATION=0.50
# Max replicas the predictive policy may add per decision (0 = SCALE_STEP)
PREDICTIVE_MAX_STEP=0

MODEL_DIR=data/models
TELEMETRY_PATH=data/runtime/telemetry_snapshots.jsonl
SCALING_EVENTS_PATH=data/runtime/scaling_events.jsonl

# Local estimated economics (educational only)
COST_PER_REPLICA_MINUTE=0.0035
SAVINGS_BASELINE_REPLICAS=3

# panel = traffic is controlled live from the dashboard (recommended).
# Fixed profiles also work: constant, ramp, spike, burst, traffic-drop
LOCUST_PROFILE=panel

# Background retraining of the forecaster on the optimizer's own telemetry
AUTO_TRAIN=true
AUTO_TRAIN_MIN_ROWS=80
AUTO_TRAIN_INTERVAL_MINUTES=10
# Deploy a model only if it beats the "rate stays the same" baseline on held-out rows
AUTO_TRAIN_REQUIRE_IMPROVEMENT=true
LOCUST_WORK_INTENSITY=low
