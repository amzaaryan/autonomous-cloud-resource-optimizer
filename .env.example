# Copy to .env and adjust values.
PROMETHEUS_URL=http://prometheus:9090

TARGET_SERVICE_NAME=target-service
TARGET_SERVICE_PORT=8000

# Workload intensity for target-service /work endpoint
WORK_INTENSITY_LOW_ITERATIONS=50000
WORK_INTENSITY_MEDIUM_ITERATIONS=250000
WORK_INTENSITY_HIGH_ITERATIONS=1000000

MIN_REPLICAS=1
MAX_REPLICAS=5
SCALE_STEP=1
COOLDOWN_SECONDS=60
CPU_SCALE_UP_THRESHOLD=0.70
CPU_SCALE_DOWN_THRESHOLD=0.35
MEMORY_SCALE_UP_THRESHOLD=0.75
LATENCY_SLA_MS=500
ERROR_RATE_SLA=0.05

TELEMETRY_INTERVAL_SECONDS=15
FORECAST_HORIZONS_MINUTES=1,3,5

# Keep DRY_RUN=true for local Compose baseline.
DRY_RUN=true
# compose (default, dry-run scaling path) or swarm (real scaling path via Docker SDK)
SCALING_MODE=compose

MODEL_DIR=data/models
TELEMETRY_PATH=data/runtime/telemetry_snapshots.jsonl
SCALING_EVENTS_PATH=data/runtime/scaling_events.jsonl

# Local estimated economics (educational only)
COST_PER_REPLICA_MINUTE=0.0035
SAVINGS_BASELINE_REPLICAS=3

# Locust profile options: constant, ramp, spike, burst, traffic-drop
LOCUST_PROFILE=constant
LOCUST_WORK_INTENSITY=medium
