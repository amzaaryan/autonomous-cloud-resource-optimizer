# Demo profile:  docker compose --env-file .env.demo up -d --build      (or: make demo)
# Real scaling ON, quicker reaction. Everything not listed keeps its default from docker-compose.yml.
DRY_RUN=false
COOLDOWN_SECONDS=30
PREDICTIVE_MAX_STEP=2
LOCUST_WORK_INTENSITY=low
# Retrain more often so the dashboard shows the model arriving during a rehearsal
AUTO_TRAIN_INTERVAL_MINUTES=5
